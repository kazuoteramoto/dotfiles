[user]
    name = "{{ .name }}"
    email = "{{ .email }}"
[color]
    status = auto
    ui = true
[core]
    excludesfile = {{ .chezmoi.homeDir }}/.gitignore
    whitespace = trailing-space,space-before-tab
    pager = delta
[alias]
    s = status --short --branch
    branch-wt = "!f() { \\\n    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then \\\n        echo \"fatal: not a git repository\" >&2; \\\n        return 1; \\\n    fi; \\\n    branch=\"$1\"; \\\n    cd $(git rev-parse --path-format=absolute --git-common-dir)/..; \\\n    if ! git show-ref --quiet $branch; then \\\n        git branch $branch; \\\n    fi; \\\n    git worktree add \"$branch\" \"$branch\"; \\\n    cd \"$branch\"; \\\n}; f"
[push]
    default = current
[advice]
    statusHints = false
[diff]
    renames = copies
    mnemonicprefix = true
    colorMoved = default
[apply]
    whitespace = fix
[github]
    user = {{ .github_user }}
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    light = true 
    diff-so-fancy = true
[merge]
    conflictstyle = diff3
[init]
    defaultBranch = main
